# Copy to backend/.env and fill in. Never commit the real file.

# Supabase Postgres. Use the Session pooler string (Dashboard > Connect > Session pooler):
# the direct db.<ref>.supabase.co host is IPv6-only and fails on IPv4-only networks.
DATABASE_URL=

# HuggingFace token for the optional rephrase layer (chat falls back to templates without it)
HF_TOKEN=

# "true" to log every SQL statement (default off)
DB_ECHO=
