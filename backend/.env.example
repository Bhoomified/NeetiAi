# Copy to backend/.env and fill in. Never commit the real file.

# Supabase Postgres. Use the Session pooler string (Dashboard > Connect > Session pooler):
# the direct db.<ref>.supabase.co host is IPv6-only and fails on IPv4-only networks.
DATABASE_URL=

# HuggingFace token for the optional rephrase layer (chat falls back to templates without it)
HF_TOKEN=

# "true" to log every SQL statement (default off)
DB_ECHO=

# Supabase project URL, e.g. https://<project-ref>.supabase.co — used to fetch the JWT
# public keys (JWKS) that verify every request. Required.
SUPABASE_URL=

# Only for projects still on the legacy HS256 JWT secret (Settings > JWT Keys > Legacy).
# Leave empty when the project uses asymmetric signing keys (ES256/RS256).
SUPABASE_JWT_SECRET=

# Comma-separated exact frontend origins, e.g. http://localhost:3000,https://<app>.vercel.app
CORS_ORIGINS=

# Optional overrides for per-user rate limits (slowapi syntax)
RATE_LIMIT_CHAT=
RATE_LIMIT_SEARCH=
